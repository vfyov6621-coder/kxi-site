# kxi backend service — /etc/systemd/system/kxi-api.service
# Установка:
#   sudo useradd -r -s /usr/sbin/nologin kxi
#   sudo mkdir -p /opt/kxi && sudo chown -R kxi:kxi /opt/kxi
#   # положить код ноды/API в /opt/kxi (server.js или ваш бинарник)
#   sudo cp deploy/kxi-api.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now kxi-api
# Логи:
#   journalctl -u kxi-api -f

[Unit]
Description=kxi node + API (brute-force blockchain)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kxi
WorkingDirectory=/opt/kxi
# Подстройте под свой рантайм (node / bun / go-бинарник):
ExecStart=/usr/bin/node /opt/kxi/server.js
Environment=PORT=8080
Environment=NODE_ENV=production
Restart=always
RestartSec=3

# лёгкий hardening
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
